{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lse872317312010/android-automation/blob/main/schemas/skill-manifest.v0.draft.schema.json",
  "title": "Android Automation draft-only Skill manifest",
  "description": "Data contract for review only. A schema-valid manifest is never executable or device approved.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$comment",
    "schema",
    "skill",
    "compatibility",
    "execution",
    "verification",
    "promotion",
    "rollback",
    "provenance"
  ],
  "properties": {
    "$comment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "schema": {
      "const": "android-automation.skill.v0.draft"
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "gameId",
        "description",
        "status",
        "executionEnabled"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z0-9]+(?:[_-][a-z0-9]+)*)+$",
          "minLength": 3,
          "maxLength": 96
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+-draft$",
          "maxLength": 32
        },
        "gameId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "status": {
          "const": "draft"
        },
        "executionEnabled": {
          "const": false
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packages",
        "locale",
        "apkVersionCode",
        "uiSignature",
        "engine",
        "requiredCapabilities"
      ],
      "properties": {
        "packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$",
            "minLength": 3,
            "maxLength": 160
          }
        },
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
          "minLength": 2,
          "maxLength": 35
        },
        "apkVersionCode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,29})$"
                }
              ]
            },
            "max": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]{0,29})$"
                }
              ]
            }
          }
        },
        "uiSignature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "requiredAnchors"
          ],
          "properties": {
            "profile": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 96
                }
              ]
            },
            "requiredAnchors": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              }
            }
          }
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "minVersion"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,31}$",
              "minLength": 2,
              "maxLength": 32,
              "enum": [
                "maafw",
                "autojs6-shizuku"
              ]
            },
            "minVersion": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9.+-]{1,48}$"
                }
              ]
            }
          }
        },
        "requiredCapabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "capture.fullscreen",
              "recognize.ocr",
              "act.tap",
              "verify.semantic"
            ]
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputBudget",
        "workflowPath",
        "unknownState",
        "onVersionDrift"
      ],
      "properties": {
        "inputBudget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxActions",
            "maxRetries",
            "timeoutMs"
          ],
          "properties": {
            "maxActions": {
              "const": 0
            },
            "maxRetries": {
              "const": 0
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120000
            }
          }
        },
        "workflowPath": {
          "type": "null"
        },
        "unknownState": {
          "const": "block"
        },
        "onVersionDrift": {
          "const": "quarantine"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryCondition",
        "successCondition",
        "consecutiveObservations",
        "verificationSource",
        "falseCompletionPolicy"
      ],
      "properties": {
        "entryCondition": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 512
            }
          ]
        },
        "successCondition": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 512
            }
          ]
        },
        "consecutiveObservations": {
          "type": "integer",
          "minimum": 2,
          "maximum": 10
        },
        "verificationSource": {
          "const": "deterministic"
        },
        "falseCompletionPolicy": {
          "const": "fail_closed"
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offlineRegression",
        "androidDeviceValidation",
        "review",
        "verifiedOnDevice"
      ],
      "properties": {
        "offlineRegression": {
          "const": "required"
        },
        "androidDeviceValidation": {
          "const": "required"
        },
        "review": {
          "const": "required"
        },
        "verifiedOnDevice": {
          "const": false
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lastKnownGoodVersion"
      ],
      "properties": {
        "lastKnownGoodVersion": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9.+-]{1,48}$"
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCommit",
        "assetSha256",
        "signature",
        "signer"
      ],
      "properties": {
        "sourceCommit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          ]
        },
        "assetSha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "signature": {
          "type": "null"
        },
        "signer": {
          "type": "null"
        }
      }
    }
  }
}
